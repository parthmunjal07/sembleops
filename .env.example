# SembleOps example environment
# Copy this file to .env. Never commit the populated .env file.
# Every provider account, API key, subscription, and resulting charge belongs
# to the person operating this installation.

# OpenAI API key used for routing, API-backed agents, and voice transcription.
# Optional when using only an authenticated local CLI runtime.
OPENAI_API_KEY=

# Optional Discord integration. Set both values or leave both empty.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_USER_ID=

# Web/API bearer token. Required whenever the server binds beyond loopback.
# Generate independently from WORKER_TOKEN with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
HUB_ACCESS_TOKEN=

# Remote worker shared secret. Required only for hub-plus-worker deployments.
# Generate a different value with the command above.
WORKER_TOKEN=

# Remote worker settings. The worker connects outbound to HUB_URL and may run
# coding agents only in the exact project names listed here. Each name must be
# a real direct child directory of WORKER_PROJECTS_ROOT; symlinks are rejected.
HUB_URL=http://127.0.0.1:4747
WORKER_PROJECTS_ROOT=/absolute/path/to/trusted/projects
WORKER_ALLOWED_PROJECTS=project-one,project-two

# Optional alternate node-config path. The default is config/sembleops.yaml.
# SEMBLEOPS_CONFIG=config/sembleops.yaml

# Optional comma-separated OpenAI chat model fallback order.
# SEMBLEOPS_OPENAI_CHAT_MODELS=gpt-5-mini,gpt-4o-mini,gpt-4.1-mini

# Optional comma-separated voice transcription model fallback order.
# SEMBLEOPS_OPENAI_TRANSCRIPTION_MODELS=gpt-4o-mini-transcribe,whisper-1

# Optional Codex CLI model profiles. Defaults may change between releases.
# SEMBLEOPS_DEX_CODEX_MODEL=gpt-5.5
# SEMBLEOPS_DEX_CODEX_REASONING=high
# SEMBLEOPS_CODEX_MODEL=gpt-5-mini
# SEMBLEOPS_CODEX_REASONING=low

# Legacy migration only: older versions used TRANSCRIPTION_API_KEY for the
# same OpenAI credential. New installations should use OPENAI_API_KEY.
# TRANSCRIPTION_API_KEY=
